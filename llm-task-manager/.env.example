# Environment Configuration
ENVIRONMENT=dev
DEBUG=true

# Database - Cloud SQL via Proxy (development)
# Format for dev (via Cloud SQL Proxy): postgresql+asyncpg://user:password@localhost:5432/database
# Format for prod (Unix socket): postgresql+asyncpg://user:password@/database?host=/cloudsql/PROJECT_ID:REGION:INSTANCE
DATABASE_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/llm_task_manager

# JWT Authentication (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# GCP Configuration
GCP_PROJECT_ID=PROJECT_ID
GCP_REGION=europe-west1
CLOUD_SQL_INSTANCE=wsf-archi-tpfinal:europe-west1:llm-task-manager-db

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=*
